<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Plano_Flink_Kafka">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variáveis Definidas Pelo Usuário">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Grupo de Usuários">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,50)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Controlador de Iteração">
          <stringProp name="LoopController.loops">${__P(loops,10000)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Configuração dos dados CSV">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding"></stringProp>
          <stringProp name="filename">${__P(csvfile,D:/TCC/GeradorDeDados/MassaDeDados/eventos_100000.csv)}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="variableNames">id_evento,veiculo_id,latitude,longitude,velocidade,temperatura_carga,status_rota,data_hora</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Enviar evento Kafka">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.kafka.clients.producer.KafkaProducer
import org.apache.kafka.clients.producer.ProducerRecord
import java.util.Properties

def producer = vars.getObject(&quot;kafkaProducer&quot;)

if (producer == null) {
    def props = new Properties()
    props.put(&quot;bootstrap.servers&quot;, org.apache.jmeter.util.JMeterUtils.getPropDefault(&quot;kafkaserver&quot;, &quot;localhost:9092&quot;))
    props.put(&quot;key.serializer&quot;, &quot;org.apache.kafka.common.serialization.StringSerializer&quot;)
    props.put(&quot;value.serializer&quot;, &quot;org.apache.kafka.common.serialization.StringSerializer&quot;)
    props.put(&quot;acks&quot;, &quot;1&quot;)
    props.put(&quot;retries&quot;, &quot;0&quot;)
    props.put(&quot;linger.ms&quot;, &quot;0&quot;)

    producer = new KafkaProducer&lt;String, String&gt;(props)
    vars.putObject(&quot;kafkaProducer&quot;, producer)
}

String idEvento = vars.get(&quot;id_evento&quot;)
String veiculoId = vars.get(&quot;veiculo_id&quot;)
String latitude = vars.get(&quot;latitude&quot;)
String longitude = vars.get(&quot;longitude&quot;)
String velocidade = vars.get(&quot;velocidade&quot;)
String temperaturaCarga = vars.get(&quot;temperatura_carga&quot;)
String statusRota = vars.get(&quot;status_rota&quot;)
String dataHora = vars.get(&quot;data_hora&quot;)

String json = &quot;&quot;&quot;
{
  &quot;id_evento&quot;: ${idEvento},
  &quot;veiculo_id&quot;: ${veiculoId},
  &quot;latitude&quot;: ${latitude},
  &quot;longitude&quot;: ${longitude},
  &quot;velocidade&quot;: ${velocidade},
  &quot;temperatura_carga&quot;: ${temperaturaCarga},
  &quot;status_rota&quot;: &quot;${statusRota}&quot;,
  &quot;data_hora&quot;: &quot;${dataHora}&quot;
}
&quot;&quot;&quot;.toString()

ProducerRecord&lt;String, String&gt; record = new ProducerRecord&lt;String, String&gt;(
    &quot;eventos-transporte&quot;,
    idEvento.toString(),
    json
)

producer.send(record).get()</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
